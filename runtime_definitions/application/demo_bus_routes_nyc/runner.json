{
  "pipeline": "route_data_v3",
  "default_runner": {
    "input": {
      "file_path": "./data/routes.csv",
      "file_seperator": ";"
    },
    "output": {
      "save_dir": "./views/application/demo_bus_routes_nyc/data"
    },
    "routing": {
      "route_type": "both",
      "start_routes": null,
      "max_routes": null
    },
    "algorithm": {
      "E": 5.0,
      "z": 0.0,
      "k_max": 25,
      "k_all": 1,
      "B": 10,
      "solver_tsp": "ortools",
      "solver_hpp": "ortools",
      "deterministic_tsp": true,
      "deterministic_hpp": true,
      "precheck": true,
      "ortools_time_limit": 2,
      "initial_point_method": { "method": "GREEDY_DNN" },
      "type1_methods": ["A", "B", "U"],
      "type2_methods": ["A", "B"],
      "A_kwargs": null,
      "B_kwargs": null,
      "U_kwargs": {
        "max_combination_size": 2,
        "max_union_size": 10,
        "min_union_size": 3
      }
    },
    "geometry": {
      "allowed_highways": null,
      "chunk_size_osm": null,
      "chunk_size_osrm": 50,
      "use_rotated_side": false,
      "offset_m": 2.5,
      "entry_angle_deg": -60.0,
      "exit_angle_deg": 60.0,
      "unit_entry_exit_strategy": null
    },
    "mappings": {
      "col_map": {
        "route_id": { "name": "RouteId" },
        "lon": { "name": "lon" },
        "lat": { "name": "lat" },
        "line_nr": { "name": "linjenummer" },
        "L_u": { "name": "L_u" },
        "address": {
          "fields": ["Adress"],
          "separator": "; "
        },
        "type": {
          "name": "type",
          "car-newyork": { "val": "Car", "annotations": "duration" }
        },
        "problem_type": {
          "name": "problem_type",
          "HPP": ["HPP"],
          "TSP": ["TSP"],
          "OUT:HPP": ["OUT:HPP"],
          "OUT:TSP": ["OUT:TSP"]
        },
        "revenue": {
          "path_revenue": "./data/route_revenue.csv",
          "sep": ";",
          "join_fields": {
            "route_id": "RouteId",
            "Adress Id": "Adress Id"
          },
          "rev_fields": ["Oms"],
          "rev_formula": "SUM",
          "rev_include_all_addresses": true
        },
        "group_by_route_id": true
      }
    },
    "flags": {
      "use_data": true,
      "index_filename": "routes_index.json",
      "skip_if_output_exists": true
    }
  },
  "label_list": [
    {
      "c_cache_config": {
        "label": "All Routes",
        "base_path": "./views/application/demo_bus_routes_nyc",
        "enabled": false
      },
      "label_explanation": "Alle MTA-ruter uden ekstra filtrering.",
      "rev_include_all_addresses": true,
      "overwrite": {
        "mappings": {
          "col_map": {}
        }
      }
    },
    {
      "c_cache_config": {
        "label": "Day Busses",
        "base_path": "./views/application/demo_bus_routes_nyc",
        "enabled": false
      },
      "label_explanation": "Kun ruter markeret som Day Busses i route_group.",
      "selector": {
        "column": "route_group",
        "values": ["Day Busses"]
      },
      "rev_include_all_addresses": true,
      "overwrite": {
        "mappings": {
          "col_map": {}
        }
      }
    },
    {
      "c_cache_config": {
        "label": "Evening Busses",
        "base_path": "./views/application/demo_bus_routes_nyc",
        "enabled": false
      },
      "label_explanation": "Kun ruter markeret som Evening Busses i route_group.",
      "selector": {
        "column": "route_group",
        "values": ["Evening Busses"]
      },
      "rev_include_all_addresses": true,
      "overwrite": {
        "mappings": {
          "col_map": {}
        }
      }
    },
    {
      "c_cache_config": {
        "label": "Morning",
        "base_path": "./views/application/demo_bus_routes_nyc",
        "enabled": false
      },
      "label_explanation": "Kun ruter markeret som Morning i route_group.",
      "selector": {
        "column": "route_group",
        "values": ["Morning"]
      },
      "rev_include_all_addresses": true,
      "overwrite": {
        "mappings": {
          "col_map": {}
        }
      }
    },
    {
      "c_cache_config": {
        "label": "Night",
        "base_path": "./views/application/demo_bus_routes_nyc",
        "enabled": false
      },
      "label_explanation": "Kun ruter markeret som Night i route_group.",
      "selector": {
        "column": "route_group",
        "values": ["Night"]
      },
      "rev_include_all_addresses": true,
      "overwrite": {
        "mappings": {
          "col_map": {}
        }
      }
    },
    {
      "c_cache_config": {
        "label": "Rush Hour",
        "base_path": "./views/application/demo_bus_routes_nyc",
        "enabled": false
      },
      "label_explanation": "Kun ruter markeret som Rush Hour i route_group.",
      "selector": {
        "column": "route_group",
        "values": ["Rush Hour"]
      },
      "rev_include_all_addresses": true,
      "overwrite": {
        "mappings": {
          "col_map": {}
        }
      }
    }
  ],
  "APR_profiles": [
    {
      "APR Label": "MTA Car New York",
      "APR_explanation": "Bilprofil for New York, beregnet via den separate OSRM-car-newyork service i sekunder.",
      "APR": {
        "car-newyork": {
          "duration": 0.03944
        }
      }
    }
  ],
  "revenue_list": [
    {
      "revenue label": "MTA 2024-10-15",
      "revenue_explanation": "Omsaetningen er den modellerede MTA stop/daypart-proxy fra route_revenue.csv for sample-datoen 2024-10-15.",
      "revenue": {
        "path_revenue": "./data/route_revenue.csv",
        "sep": ";",
        "join_fields": {
          "route_id": "RouteId",
          "Adress Id": "Adress Id"
        },
        "rev_fields": ["Oms"],
        "rev_formula": "SUM",
        "rev_include_all_addresses": true
      }
    }
  ]
}
